{
  "scan_roots": ["app", "AI", "webapp"],
  "scan_files": ["launcher.py"],
  "max_key_token_length": 48,
  "skip_docstrings": true,
  "skip_files": [
    "app/config/paths.py"
  ],
  "ast_rules": [
    "inline_url",
    "non_ascii",
    "text_literal",
    "long_literal",
    "word_set"
  ],
  "rules": [
    {
      "id": "raw_sql",
      "flags": "i",
      "pattern": "\\b(SELECT\\s+.+\\s+FROM|INSERT\\s+INTO|UPDATE\\s+\\w+\\s+SET|DELETE\\s+FROM|DROP\\s+TABLE)\\b"
    },
    {
      "id": "inline_url",
      "flags": "i",
      "pattern": "https?://[^\\s\"']+"
    },
    {
      "id": "secret_like",
      "flags": "i",
      "pattern": "(api[_-]?key|bot[_-]?token|password)\\s*=\\s*['\"][^'\"]+['\"]"
    },
    {
      "id": "abs_windows_path",
      "flags": "i",
      "pattern": "[A-Za-z]:\\\\[^\\s\"']+"
    },
    {
      "id": "inline_regex",
      "flags": "",
      "pattern": "re\\.(compile|match|search|findall)\\(\\s*r?['\"]"
    },
    {
      "id": "hardcoded_numeric_id",
      "flags": "",
      "pattern": "(?<![\\w.])\\d{8,}(?![\\w.])"
    },
    {
      "id": "print_statement",
      "flags": "",
      "pattern": "\\bprint\\s*\\("
    }
  ]
}
